{
  "info": {
    "name": "Guardians of the Harvest API",
    "description": "Requests for the backend API (docs/api-contract.yaml). Start the server with `make dev`; baseUrl defaults to http://localhost:8000. Demo field: Alajuela, Costa Rica (lat 10.0, lon -84.2). Expected responses: backend/docs/examples/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Meta",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness, active data_mode and MVP region."
          }
        }
      ]
    },
    {
      "name": "Crops",
      "item": [
        {
          "name": "List crops",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/crops",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "crops"
              ]
            },
            "description": "Crops in the MVP scope with tolerance ranges. Example: docs/examples/crops.json"
          }
        }
      ]
    },
    {
      "name": "Conditions",
      "item": [
        {
          "name": "Conditions - Alajuela",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conditions?lat=10.0&lon=-84.2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conditions"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "10.0"
                },
                {
                  "key": "lon",
                  "value": "-84.2"
                }
              ]
            },
            "description": "Monthly climate, season summary and soil. Example: docs/examples/conditions_alajuela.json"
          }
        }
      ]
    },
    {
      "name": "Planting windows",
      "item": [
        {
          "name": "Planting windows - San Carlos (MVP crops)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Best sowing months per crop: each month scored over the crop's cycle.",
            "url": {
              "raw": "{{baseUrl}}/planting-windows?lat=11.0&lon=-84.6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "planting-windows"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "11.0"
                },
                {
                  "key": "lon",
                  "value": "-84.6"
                }
              ]
            }
          }
        },
        {
          "name": "Planting windows - San Carlos, beans and maize",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Only the requested crops (repeat the crops parameter).",
            "url": {
              "raw": "{{baseUrl}}/planting-windows?lat=11.0&lon=-84.6&crops=beans&crops=maize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "planting-windows"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "11.0"
                },
                {
                  "key": "lon",
                  "value": "-84.6"
                },
                {
                  "key": "crops",
                  "value": "beans"
                },
                {
                  "key": "crops",
                  "value": "maize"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Weather",
      "item": [
        {
          "name": "Daily weather - San José, Jan 2026",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/weather/daily?lat=9.93&lon=-84.08&start=2026-01-01&end=2026-01-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "weather",
                "daily"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "9.93"
                },
                {
                  "key": "lon",
                  "value": "-84.08"
                },
                {
                  "key": "start",
                  "value": "2026-01-01"
                },
                {
                  "key": "end",
                  "value": "2026-01-31"
                }
              ]
            },
            "description": "NASA POWER daily mean/max/min temperature and rainfall. Example: docs/examples/weather_daily_san_jose.json"
          }
        }
      ]
    },
    {
      "name": "Erosion",
      "item": [
        {
          "name": "Erosion - San José, Jan 2026",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/erosion?lat=9.93&lon=-84.08&start=2026-01-01&end=2026-01-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "erosion"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "9.93"
                },
                {
                  "key": "lon",
                  "value": "-84.08"
                },
                {
                  "key": "start",
                  "value": "2026-01-01"
                },
                {
                  "key": "end",
                  "value": "2026-01-31"
                }
              ]
            },
            "description": "Terrain (SRTM slope) and combined (slope + rain) erosion risk. Example: docs/examples/erosion_san_jose.json"
          }
        }
      ]
    },
    {
      "name": "Soil",
      "item": [
        {
          "name": "Soil profile - San José",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/soil?lat=9.93&lon=-84.08",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soil"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "9.93"
                },
                {
                  "key": "lon",
                  "value": "-84.08"
                }
              ]
            },
            "description": "OpenLandMap soil at 0, 10, 30 cm. Example: docs/examples/soil_san_jose.json"
          }
        }
      ]
    },
    {
      "name": "Recommendations",
      "item": [
        {
          "name": "Recommend - Alajuela vs current maize-maize",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations"
              ]
            },
            "description": "Top 3 rotations plus the farmer's current one. Example: docs/examples/recommendation_alajuela.json",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 10.0,\n  \"lon\": -84.2,\n  \"priorities\": {\n    \"water\": 0.4,\n    \"soil\": 0.3,\n    \"climate\": 0.3\n  },\n  \"current_rotation\": [\n    \"maize\",\n    \"maize\"\n  ],\n  \"top_n\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Recommend - minimal (MVP defaults)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations"
              ]
            },
            "description": "Only a location: MVP crops, priorities and top_n from config/mvp.yaml.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 10.0,\n  \"lon\": -84.2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Recommend - water first",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations"
              ]
            },
            "description": "Same field, a farmer who cares mostly about water.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 10.0,\n  \"lon\": -84.2,\n  \"priorities\": {\n    \"water\": 0.7,\n    \"soil\": 0.15,\n    \"climate\": 0.15\n  },\n  \"current_rotation\": [\n    \"maize\",\n    \"maize\"\n  ],\n  \"top_n\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Errors (expected 422)",
      "item": [
        {
          "name": "Outside region -> out_of_region",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations"
              ]
            },
            "description": "Point outside the MVP bbox.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 40.0,\n  \"lon\": -3.7,\n  \"priorities\": {\n    \"water\": 0.4,\n    \"soil\": 0.3,\n    \"climate\": 0.3\n  },\n  \"current_rotation\": [\n    \"maize\",\n    \"maize\"\n  ],\n  \"top_n\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Unknown crop -> unknown_crop",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations"
              ]
            },
            "description": "Crop id not in GET /crops.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 10.0,\n  \"lon\": -84.2,\n  \"priorities\": {\n    \"water\": 0.4,\n    \"soil\": 0.3,\n    \"climate\": 0.3\n  },\n  \"current_rotation\": [\n    \"maize\",\n    \"coffee\"\n  ],\n  \"top_n\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Wrong rotation length -> invalid_rotation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations"
              ]
            },
            "description": "current_rotation needs one crop per season.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 10.0,\n  \"lon\": -84.2,\n  \"priorities\": {\n    \"water\": 0.4,\n    \"soil\": 0.3,\n    \"climate\": 0.3\n  },\n  \"current_rotation\": [\n    \"maize\"\n  ],\n  \"top_n\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Missing lat -> validation_failed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations"
              ]
            },
            "description": "Required field missing.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lon\": -84.2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Conditions outside region -> out_of_region",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conditions?lat=40.0&lon=-3.7",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conditions"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "40.0"
                },
                {
                  "key": "lon",
                  "value": "-3.7"
                }
              ]
            },
            "description": "Point outside the MVP bbox."
          }
        },
        {
          "name": "422 validation_failed - erosion period longer than 366 days",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/erosion?lat=9.93&lon=-84.08&start=2024-01-01&end=2025-01-01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "erosion"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "9.93"
                },
                {
                  "key": "lon",
                  "value": "-84.08"
                },
                {
                  "key": "start",
                  "value": "2024-01-01"
                },
                {
                  "key": "end",
                  "value": "2025-01-01"
                }
              ]
            },
            "description": "start/end must be at most 366 days apart (inclusive)."
          }
        }
      ]
    }
  ]
}
