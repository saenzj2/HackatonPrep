# Copy to backend/.env (make setup does it for you) and fill in locally.
# NEVER commit .env and NEVER hardcode keys in code.

# Overrides data_mode from config/mvp.yaml: mock | cached | live
# DATA_MODE=

# NASA POWER needs no key. Add keys here only for sources that require one, e.g.:
# EARTHDATA_TOKEN=

# Comma-separated origins allowed to call the API (frontend dev servers)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
