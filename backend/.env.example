# Copy to backend/.env (make setup does it for you) and fill in locally.
# NEVER commit .env and NEVER hardcode keys in code.

# Overrides data_mode from config/mvp.yaml: mock | cached | live
# DATA_MODE=

# NASA POWER needs no key. Add keys here only for sources that require one, e.g.:
# EARTHDATA_TOKEN=

# Comma-separated origins allowed to call the API (frontend dev servers)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# OpenTopography API key (SRTM elevation). Free: opentopography.org -> MyOpenTopo -> Request API key.
# Only needed in live mode to fetch new locations; cached and mock modes work without it.
OPEN_TOPOGRAPHY_KEY=
# Google Earth Engine (OpenLandMap soil): Cloud project registered for Earth Engine.
# Local auth: run `earthengine authenticate` once. Only needed in live mode for new locations.
# Defaults to the team project (app/settings.py); set only to use a different one.
# GEE_PROJECT_ID=
# Deployment only: path to a service-account JSON key file. NEVER commit the key file itself.
# GEE_SERVICE_ACCOUNT_KEY_FILE=
